# VHI 7.x – copy to .env and set values (never commit .env)
VHI_BASE_URL=https://172.16.218.7
VHI_USER=admin
# Set your VHI password in .env only (e.g. VHI_PASSWORD=yourpassword)
VHI_PASSWORD=Nexpass8188!
VHI_PROJECT_ID=default
VHI_PROJECT_NAME=admin
VHI_DOMAIN_ID=default

# LLM – pick provider: anthropic (Claude), gemini (Google) or openai (when implemented)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Gateway
PORT=18789
NODE_ENV=development

# Web UI Security (Optional: require password to access the web chat)
# WEB_PASSWORD=mysecretpassword

# Optional: Prometheus for health metrics
PROMETHEUS_URL=

# Optional: Slack (when using Slack channel)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
