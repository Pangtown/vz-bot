# VHI 7.x – copy to .env and set values (never commit .env)
VHI_BASE_URL=https://172.16.218.7
VHI_USER=admin
# Set your VHI password in .env only — never commit a real password
VHI_PASSWORD=changeme
VHI_PROJECT_ID=default
VHI_PROJECT_NAME=admin
VHI_DOMAIN_ID=default

# LLM – pick provider: anthropic (Claude), gemini (Google) or openai (when implemented)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Gateway
PORT=18789
NODE_ENV=development

# Web UI Security — strongly recommended: without this, the chat API,
# VHI dashboard API, and SSH terminal are open to anyone who can reach the port
WEB_PASSWORD=

# TLS: self-signed VHI certs are accepted only for VHI hosts.
# Set to 1 to require valid certs everywhere (use NODE_EXTRA_CA_CERTS for the VHI CA)
# VHI_VERIFY_TLS=1

# Optional: Prometheus for health metrics
PROMETHEUS_URL=

# Optional: Slack (when using Slack channel)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# Required. Encrypts saved cluster passwords in data/clusters.json (any long random string).
CLUSTER_SECRET_KEY=
